# OpenManus local Ollama deployment. Keep this file secret-free and commit-safe.
LOCAL_LLM_MODEL=qwen2.5-coder:7b
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_API_KEY=ollama

VISION_LLM_MODEL=gemma3:4b
VISION_LLM_BASE_URL=http://host.docker.internal:11434/v1
VISION_LLM_API_KEY=ollama

REASONING_LLM_MODEL=deepseek-r1:7b
REASONING_LLM_BASE_URL=http://host.docker.internal:11434/v1
REASONING_LLM_API_KEY=ollama
REASONING_LLM_ENABLED=true

RESEARCH_LLM_MODEL=qwen2.5:3b
RESEARCH_LLM_BASE_URL=http://host.docker.internal:11434/v1
RESEARCH_LLM_API_KEY=ollama

CREATIVITY_LLM_MODEL=llama3.2:3b
CREATIVITY_LLM_BASE_URL=http://host.docker.internal:11434/v1
CREATIVITY_LLM_API_KEY=ollama

# CPU-first resource policy for a 16 GB laptop.
PLATFORM_MAX_MODEL_CONCURRENCY=1
PLATFORM_MAX_CONCURRENT_TASKS=1
PLATFORM_MODEL_TIMEOUT_SECONDS=600
LLM_REQUEST_TIMEOUT=180

# Optional one-time downloads on the host running Ollama (not inside Docker):
# ollama pull qwen2.5-coder:7b
# ollama pull gemma3:4b
# ollama pull deepseek-r1:7b
# ollama pull qwen2.5:3b
# ollama pull llama3.2:3b
# Local downloads are free but require disk/RAM; review each model's license.
